# =============================================
# .htaccess - Telos Technologies
# Domínio principal: cici.net.br
# Configuração de redirecionamentos e subdomínios
# =============================================

RewriteEngine On
RewriteBase /

# --- Redirecionamento para HTTPS (forçar SSL) ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Redirecionamento de www para não-www (ou vice-versa) ---
# Opção: redirecionar www para não-www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# --- Subdomínios e seus diretórios ---
# chat.cici.net.br → /chat/
RewriteCond %{HTTP_HOST} ^chat\.cici\.net\.br$ [NC]
RewriteCond %{REQUEST_URI} !^/chat/
RewriteRule ^(.*)$ /chat/$1 [L]

# docs.cici.net.br → /docs/
RewriteCond %{HTTP_HOST} ^docs\.cici\.net\.br$ [NC]
RewriteCond %{REQUEST_URI} !^/docs/
RewriteRule ^(.*)$ /docs/$1 [L]

# blog.cici.net.br → /blog/
RewriteCond %{HTTP_HOST} ^blog\.cici\.net\.br$ [NC]
RewriteCond %{REQUEST_URI} !^/blog/
RewriteRule ^(.*)$ /blog/$1 [L]

# termos.cici.net.br → /termos.html
RewriteCond %{HTTP_HOST} ^termos\.cici\.net\.br$ [NC]
RewriteRule ^$ /termos.html [L]
RewriteCond %{HTTP_HOST} ^termos\.cici\.net\.br$ [NC]
RewriteRule ^(.*)$ /termos.html [L]

# privacidade.cici.net.br → /privacidade.html
RewriteCond %{HTTP_HOST} ^privacidade\.cici\.net\.br$ [NC]
RewriteRule ^$ /privacidade.html [L]
RewriteCond %{HTTP_HOST} ^privacidade\.cici\.net\.br$ [NC]
RewriteRule ^(.*)$ /privacidade.html [L]

# faq.cici.net.br → /faq.html
RewriteCond %{HTTP_HOST} ^faq\.cici\.net\.br$ [NC]
RewriteRule ^$ /faq.html [L]
RewriteCond %{HTTP_HOST} ^faq\.cici\.net\.br$ [NC]
RewriteRule ^(.*)$ /faq.html [L]

# --- Páginas principais (HTML amigáveis) ---
# Remover extensão .html das URLs (opcional)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# --- Redirecionamento de erro 404 para página customizada ---
ErrorDocument 404 /404.html

# --- Configurações de segurança ---
# Bloquear acesso a arquivos ocultos
RedirectMatch 403 /\..*$

# Bloquear acesso a diretórios sensíveis
RedirectMatch 403 ^/config/.*$
RedirectMatch 403 ^/includes/.*$

# --- Cache de arquivos estáticos (otimização) ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule>

# --- Compressão GZIP ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# --- Headers de segurança ---
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>